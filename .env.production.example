# Production Environment Configuration Template
# Carbon Project Management Platform
#
# IMPORTANT: Copy this file to .env.production and fill in actual values
# NEVER commit .env.production to version control
# Use a secure secrets manager (AWS Secrets Manager, HashiCorp Vault, etc.)

# ─────────────────────────────────────────────────────────────────────────────
# Application Environment
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=5000

# ─────────────────────────────────────────────────────────────────────────────
# Database Configuration
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (use managed database in production)
# Format: postgresql://username:password@host:port/database
# Examples:
#   - Amazon RDS: postgresql://user:pass@cpms.xxxxx.us-east-1.rds.amazonaws.com:5432/carbon_db
#   - Google Cloud SQL: postgresql://user:pass@35.x.x.x:5432/carbon_db
#   - Azure Database: postgresql://user@server:pass@server.postgres.database.azure.com:5432/carbon_db
#   - Supabase: postgresql://postgres.xxxxx:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://cpms_user:secure_password_here@prod-db.example.com:5432/carbon_cpms_db

# ─────────────────────────────────────────────────────────────────────────────
# Authentication & Security
# ─────────────────────────────────────────────────────────────────────────────

# JWT Secret for token signing (minimum 32 characters, use cryptographically secure)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-secure-random-jwt-secret-minimum-32-characters-long-change-this

# ─────────────────────────────────────────────────────────────────────────────
# CORS Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Frontend origin (production domain)
# Single origin (recommended):
CORS_ORIGIN=https://yourdomain.com

# Multiple origins (if needed):
# CORS_ORIGIN=https://yourdomain.com,https://app.yourdomain.com,https://admin.yourdomain.com

# ─────────────────────────────────────────────────────────────────────────────
# Storage Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Storage provider: 'local' or 's3' (use S3 in production)
STORAGE_PROVIDER=s3

# ─────────────────────────────────────────────────────────────────────────────
# AWS S3 Configuration (if STORAGE_PROVIDER=s3)
# ─────────────────────────────────────────────────────────────────────────────

# AWS Region
AWS_REGION=us-east-1

# S3 Bucket name (must be globally unique)
AWS_S3_BUCKET=carbon-cpms-documents-prod

# AWS IAM Access Key (create dedicated IAM user with S3 access only)
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE

# AWS IAM Secret Access Key
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# S3 Signed URL expiry (seconds, 1 hour = 3600)
AWS_S3_URL_EXPIRY=3600

# ─────────────────────────────────────────────────────────────────────────────
# Frontend Configuration
# ─────────────────────────────────────────────────────────────────────────────

# API endpoint (production backend URL)
VITE_API_URL=https://api.yourdomain.com

# Mapbox GL access token (get from https://account.mapbox.com/)
VITE_MAPBOX_ACCESS_TOKEN=pk.eyJ1IjoieW91cnVzZXIiLCJhIjoiY2xjMjA0YTU1MDA0OTN3cDJsdHRvYTZuaiJ9.EXAMPLE

# ─────────────────────────────────────────────────────────────────────────────
# Optional Features
# ─────────────────────────────────────────────────────────────────────────────

# Enable PostGIS for advanced geographic operations
USE_POSTGIS=false

# Logging level: debug, info, warn, error
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────────────────
# Optional: Monitoring & Analytics
# ─────────────────────────────────────────────────────────────────────────────

# Sentry error tracking (optional)
# SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/123456

# New Relic monitoring (optional)
# NEW_RELIC_LICENSE_KEY=your-new-relic-key

# Datadog APM (optional)
# DD_API_KEY=your-datadog-api-key

# ─────────────────────────────────────────────────────────────────────────────
# Optional: Email Configuration
# ─────────────────────────────────────────────────────────────────────────────

# SMTP settings for email notifications
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=SG.XXXXXXXXX
# SMTP_FROM=noreply@yourdomain.com

# ─────────────────────────────────────────────────────────────────────────────
# Security Headers
# ─────────────────────────────────────────────────────────────────────────────

# Content Security Policy (CSP) directive
# CSP_HEADER=default-src 'self'; script-src 'self' 'unsafe-inline' https://api.mapbox.com; connect-src 'self' https://api.mapbox.com https://events.mapbox.com

# ─────────────────────────────────────────────────────────────────────────────
# Redis Configuration (for distributed caching in multi-server setup)
# ─────────────────────────────────────────────────────────────────────────────

# REDIS_URL=redis://:password@redis-server.example.com:6379

# ─────────────────────────────────────────────────────────────────────────────
# Rate Limiting (optional)
# ─────────────────────────────────────────────────────────────────────────────

# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
