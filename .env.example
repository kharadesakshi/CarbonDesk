# Development Environment Configuration Template
# Carbon Project Management Platform
#
# Copy this file to .env and fill in values for local development

# ─────────────────────────────────────────────────────────────────────────────
# Application Environment
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5000

# ─────────────────────────────────────────────────────────────────────────────
# Database Configuration (Local Development)
# ─────────────────────────────────────────────────────────────────────────────

# Local PostgreSQL
DATABASE_URL=postgresql://cpms_user:cpms_password@localhost:5432/carbon_cpms_db

# Docker Compose PostgreSQL
# DATABASE_URL=postgresql://cpms_user:cpms_password@postgres:5432/carbon_cpms_db

# ─────────────────────────────────────────────────────────────────────────────
# Authentication & Security
# ─────────────────────────────────────────────────────────────────────────────

# Development JWT Secret (not secure, for dev only)
JWT_SECRET=dev-secret-key-min-32-characters-long-change-for-production

# ─────────────────────────────────────────────────────────────────────────────
# CORS Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Local development frontend
CORS_ORIGIN=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Storage Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Use local storage for development
STORAGE_PROVIDER=local

# ─────────────────────────────────────────────────────────────────────────────
# Frontend Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Development backend
VITE_API_URL=http://localhost:5000/api

# Get your Mapbox token from: https://account.mapbox.com/
VITE_MAPBOX_ACCESS_TOKEN=your_mapbox_token_here

# ─────────────────────────────────────────────────────────────────────────────
# Optional Features
# ─────────────────────────────────────────────────────────────────────────────

# Enable PostGIS (requires PostGIS extension in PostgreSQL)
USE_POSTGIS=false

# Logging level: debug, info, warn, error
LOG_LEVEL=debug

# ─────────────────────────────────────────────────────────────────────────────
# Optional: AWS S3 (for testing S3 integration locally)
# ─────────────────────────────────────────────────────────────────────────────

# STORAGE_PROVIDER=s3
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=carbon-cpms-documents-dev
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
